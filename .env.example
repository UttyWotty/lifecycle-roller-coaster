# Copy this file to .env and add your key. Never commit .env.
# Never prefix these with NEXT_PUBLIC_, because that would ship them to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# "fixture" ignores your story, returns sample events and spends no tokens.
# "anthropic" has Claude read your story, which needs a key and spends tokens.
EXTRACTOR_MODE=fixture
