# Copy this file to .env and add your key. Never commit .env.
# Never prefix these with NEXT_PUBLIC_, because that would ship them to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# "fixture" ignores your story, returns sample events and spends no tokens.
# "anthropic" has Claude read your story, which needs a key and spends tokens.
EXTRACTOR_MODE=fixture

# Public hosting only (see "Deploying" in the README). Locally, limits are kept in memory.
# Spend allowed across all visitors per UTC day, in dollars. Defaults to 1.
DAILY_BUDGET_USD=1
# Upstash Redis REST settings, added for you by the Vercel Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional secret for hashing visitor addresses. Defaults to the store token.
RATE_LIMIT_SECRET=
